# =====================================================================
# ferment-agent VPS stack (traefik + n8n + postgres)
# คัดลอกเป็น .env แล้วใส่ค่าจริง:  cp .env.example .env
# =====================================================================

# ---- Traefik / HTTPS ----
SSL_EMAIL=your-email@example.com
SUBDOMAIN=n8n
DOMAIN_NAME=yourdomain.com
GENERIC_TIMEZONE=Asia/Bangkok

# ---- Postgres ----
# ถ้าค่ามีอักขระพิเศษ (; @ , #) ต้องครอบ quote:  POSTGRES_PASSWORD='p@ss;word,'
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---- RAPT API ----
# username = อีเมลที่ล็อกอิน rapt.io, secret = API secret จากหน้า account
RAPT_USERNAME=
RAPT_API_SECRET=

# ---- Discord Interactions (slash commands, task #35) ----
# จาก Discord Developer Portal > Application > General Information
# ไม่ใช่ secret เหมือน bot token แต่แยกเก็บไว้ให้เป็นระเบียบ
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# ---- Brewfather API (recipes/yeasts cache) ----
# จาก Brewfather app > Settings > API > GENERATE (เลือก scope recipes.read + inventory.read)
BREWFATHER_USER_ID=
BREWFATHER_API_KEY=

# ---- Grafana (แดชบอร์ด, 10 ก.ย.) ----
GRAFANA_HOST=grafana.example.com
GF_ADMIN_EMAIL=            # อีเมล Google ที่จะให้ login ได้ (เฉพาะอีเมลนี้)
GF_ADMIN_PASSWORD=         # รหัส admin สำรอง สร้างอัตโนมัติตอน setup
GF_GOOGLE_CLIENT_ID=       # จาก Google Cloud Console
GF_GOOGLE_CLIENT_SECRET=
GF_DB_PASSWORD=            # รหัสของ user grafana_ro สร้างอัตโนมัติ
