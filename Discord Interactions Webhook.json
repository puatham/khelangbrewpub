        "jsCode": "const cmd = $('Parse Interaction Command').first().json;\nconst content = cmd.action === 'start'\n  ? ('✅ เริ่ม batch: ' + (cmd.beer || '(ไม่ระบุชื่อเบียร์)') + '\\nPill: ' + cmd.pill + ' ↔ Controller: ' + cmd.controller + '\\nเริ่มหมักเมื่อ: ' + DateTime.fromISO(cmd.start_date).setZone('Asia/Bangkok').toFormat('d/M/yyyy HH:mm'))\n  : ('⏹️ หยุด batch ของ Pill: ' + cmd.pill);\n\nreturn [{\n  json: {\n    content,\n    application_id: cmd.application_id,\n    interaction_token: cmd.interaction_token\n  }\n}];"
