        "jsCode": "const crypto = require('crypto');\n\nfunction pubKeyFromHex(hex) {\n  const raw = Buffer.from(hex, 'hex');\n  const der = Buffer.concat([Buffer.from('302a300506032b6570032100', 'hex'), raw]);\n  return crypto.createPublicKey({ key: der, format: 'der', type: 'spki' });\n}\n\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst signature = headers['x-signature-ed25519'];\nconst timestamp = headers['x-signature-timestamp'];\nconst rawBody = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n\nlet valid = false;\ntry {\n  const publicKey = pubKeyFromHex($env.DISCORD_PUBLIC_KEY);\n  const message = Buffer.from(timestamp + rawBody, 'utf8');\n  const sigBuf = Buffer.from(signature, 'hex');\n  valid = crypto.verify(null, message, publicKey, sigBuf);\n} catch (e) {\n  valid = false;\n}\n\nlet interaction = null;\ntry {\n  interaction = JSON.parse(rawBody);\n} catch (e) {\n  interaction = null;\n}\n\nreturn [{ json: { valid, interaction } }];"
      },
