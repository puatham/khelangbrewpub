    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet data;\nif (items.length === 1 && Array.isArray(items[0].json)) {\n  data = items[0].json;\n} else {\n  data = items.map(i => i.json);\n}\nreturn data.map(d => ({\n  json: {\n    device_id: d.id,\n    device_name: d.name,\n    device_type: 'pill',\n    raw_data: d\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
