      "name": "Format Pills"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO devices (device_id, device_name, device_type, raw_data, last_synced_at)\nVALUES ($1, $2, $3, $4, now())\nON CONFLICT (device_id) DO UPDATE\nSET device_name = EXCLUDED.device_name,\n    device_type = EXCLUDED.device_type,\n    raw_data = EXCLUDED.raw_data,\n    last_synced_at = now();",
        "options": {
          "queryReplacement": "={{$json.device_id}}, {{$json.device_name}}, {{$json.device_type}}, {{JSON.stringify($json.raw_data)}}"
