{"updatedAt":"2026-08-15T07:46:53.184Z","createdAt":"2026-08-15T07:28:16.320Z","id":"CEgY6ZpFNf1WeQ4n","name":"Discord Command Intake","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":1}]}},"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-1520,528],"id":"3f9cabb2-d858-4f68-9a8e-29f52dfbc0b7","name":"Schedule Trigger"},{"parameters":{"operation":"executeQuery","query":"SELECT value FROM bot_state WHERE key = 'last_discord_message_id';","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[-1296,528],"id":"0b372e0b-921f-4ee9-a559-1c454c8a16a5","name":"Get Last Message Id","alwaysOutputData":true,"credentials":{"postgres":{"id":"t6ZZv3ZEHRRZX5Q2","name":"Postgres account"}}},{"parameters":{"url":"=https://discord.com/api/v10/channels/1537779906820177940/messages","authentication":"predefinedCredentialType","nodeCredentialType":"discordBotApi","sendQuery":true,"queryParameters":{"parameters":[{"name":"after","value":"={{ $json.value }}"},{"name":"limit","value":"50"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[-1072,528],"id":"ad876fda-fd8f-4283-8707-d441430caa47","name":"Get New Messages","credentials":{"httpHeaderAuth":{"id":"xEdKEC5YmU5dRPBo","name":"Header Auth account"},"discordBotApi":{"id":"UoXr9Yvwl24SlcYu","name":"Discord Bot account"}}},{"parameters":{"jsCode":"const items = $input.all();\nconst results = [];\nlet maxId = $('Get Last Message Id').first().json.value;\nconst paramRegex = /(\\w+)=(?:\"([^\"]*)\"|(\\S+))/g;\n\nfor (const item of items) {\n  const m = item.json;\n  const text = (m.content || '').trim();\n  const match = text.match(/^!ferment\\s+(start|stop)\\s+(.*)$/i);\n  if (match) {\n    const action = match[1].toLowerCase();\n    const params = {};\n    let pm;\n    paramRegex.lastIndex = 0;\n    while ((pm = paramRegex.exec(match[2])) !== null) {\n      params[pm[1]] = pm[2] !== undefined ? pm[2] : pm[3];\n    }\n    results.push({ json: { action, ...params, message_id: m.id } });\n  }\n  if (BigInt(m.id) > BigInt(maxId)) maxId = m.id;\n}\n\nif (results.length === 0) {\n  results.push({ json: { action: 'none', maxId } });\n} else {\n  results.forEach(r => r.json.maxId = maxId);\n}\nreturn results;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-864,528],"id":"9fae19ff-85e9-4c89-922f-5f76153a7f44","name":"Parse Commands"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"62f36610-861b-4d69-8af2-bc0dc3790864","leftValue":"={{ $json.action }}","rightValue":"start","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2,"position":[-640,528],"id":"9abea490-73a7-4a66-bfd4-f77819b028b7","name":"Is Start?"},{"parameters":{"operation":"executeQuery","query":"INSERT INTO batches (pill_device_id, temp_controller_device_id, start_date, beer_name, status)\nSELECT\n  (SELECT device_id FROM devices WHERE trim(device_name) = trim($1) AND device_type = 'pill' LIMIT 1),\n  (SELECT device_id FROM devices WHERE trim(device_name) = trim($2) AND device_type = 'temp_controller' LIMIT 1),\n  now(),\n  $3,\n  'active'\nRETURNING batch_id;","options":{"queryReplacement":"={{$json.pill}}, {{$json.controller}}, {{$json.beer || null}}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[-416,384],"id":"71b138dc-4f1c-4403-b6eb-d75d90e0c58e","name":"Create Batch","alwaysOutputData":true,"credentials":{"postgres":{"id":"t6ZZv3ZEHRRZX5Q2","name":"Postgres account"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"3c4b94a2-8c44-499e-93f7-3aad669beb1f","leftValue":"={{ $json.action }}","rightValue":"stop","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2,"position":[-416,672],"id":"bf67dc0e-6511-4f34-a59b-d6ed6365db37","name":"Is Stop?"},{"parameters":{"operation":"executeQuery","query":"UPDATE batches SET status = 'done'\nWHERE pill_device_id = (SELECT device_id FROM devices WHERE trim(device_name) = trim($1) AND device_type = 'pill' LIMIT 1)\nAND status = 'active';","options":{"queryReplacement":"={{$json.pill}}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[-192,736],"id":"c8ee9d69-39b3-46b4-8822-c54783531da5","name":"Stop Batch","alwaysOutputData":true,"credentials":{"postgres":{"id":"t6ZZv3ZEHRRZX5Q2","name":"Postgres account"}}},{"parameters":{"method":"POST","url":"=https://discord.com/api/v10/channels/1537779906820177940/messages","authentication":"predefinedCredentialType","nodeCredentialType":"discordBotApi","sendBody":true,"bodyParameters":{"parameters":[{"name":"content","value":"={{ $('Parse Commands').item.json.action === 'start' ? ('✅ เริ่ม batch: ' + ($('Parse Commands').item.json.beer || '(ไม่ระบุชื่อเบียร์)') + '\\nPill: ' + $('Parse Commands').item.json.pill + ' ↔ Controller: ' + $('Parse Commands').item.json.controller) : ('⏹️ หยุด batch ของ Pill: ' + $('Parse Commands').item.json.pill) }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[32,528],"id":"14b94f0f-c542-4c17-92f2-010e7d5e2144","name":"Send Confirmation","credentials":{"httpHeaderAuth":{"id":"xEdKEC5YmU5dRPBo","name":"Header Auth account"},"discordBotApi":{"id":"UoXr9Yvwl24SlcYu","name":"Discord Bot account"}}},{"parameters":{"operation":"executeQuery","query":"UPDATE bot_state SET value = $1 WHERE key = 'last_discord_message_id';","options":{"queryReplacement":"={{ $('Parse Commands').item.json.maxId }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[256,528],"id":"ee449d69-fbf1-4ad2-ac17-c8a4527a11d4","name":"Update Last Message Id","credentials":{"postgres":{"id":"t6ZZv3ZEHRRZX5Q2","name":"Postgres account"}}}],"connections":{"Schedul