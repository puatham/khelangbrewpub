    {
      "parameters": {
        "jsCode": "const cmd = $('Parse Interaction Command').first().json;\nlet content;\nif (cmd.action === 'start') {\n  const created = $('Create Batch').first().json;\n  const controllerLabel = created.controller_name || '(ไม่พบ Controller ที่จับคู่ไว้ใน RAPT — เช็คการ pair ใน RAPT แล้ว sync devices ใหม่)';\n  content = '✅ เริ่ม batch: ' + cmd.beer + '\\nPill: ' + cmd.pill + ' ↔ Controller: ' + controllerLabel + '\\nเริ่มหมักเมื่อ: ' + DateTime.fromISO(cmd.start_date).setZone('Asia/Bangkok').toFormat('d/M/yyyy HH:mm');\n} else {\n  content = '⏹️ หยุด batch ของ Pill: ' + cmd.pill;\n}\n\nreturn [{\n  json: {\n    content,\n    application_id: cmd.application_id,\n    interaction_token: cmd.interaction_token\n  }\n}];"
