    {
      "parameters": {
        "jsCode": "function parseStartDate(str) {\n  if (!str) return new Date().toISOString();\n  const m = str.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})\\s+(\\d{1,2}):(\\d{2})$/);\n  if (!m) return new Date().toISOString();\n  const day = Number(m[1]), month = Number(m[2]), year = Number(m[3]), hour = Number(m[4]), minute = Number(m[5]);\n  if (month < 1 || month > 12 || day < 1 || day > 31 || hour > 23 || minute > 59) return new Date().toISOString();\n  const pad = (n) => String(n).padStart(2, '0');\n  return `${year}-${pad(month)}-${pad(day)}T${pad(hour)}:${pad(minute)}:00+07:00`;\n}\n\nconst interaction = $('Verify Signature').first().json.interaction;\nconst data = interaction.data || {};\nconst name = data.name || '';\nconst action = name === 'ferment_start' ? 'start' : (name === 'ferment_stop' ? 'stop' : (name === 'ferment_status' ? 'status' : 'unknown'));\n\nconst params = {};\n(data.options || []).forEach(opt => { params[opt.name] = opt.value; });\n\nreturn [{\n  json: {\n    action,\n    pill: params.pill,\n    controller: params.controller,\n    beer: params.beer,\n    start_date: parseStartDate(params.date),\n    application_id: interaction.application_id,\n    interaction_token: interaction.token\n  }\n}];"
      },
