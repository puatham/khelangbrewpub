        "query": "WITH pill_device AS (\n  SELECT device_id, (raw_data->>'pairedDeviceId')::uuid AS controller_id\n  FROM devices WHERE trim(device_name) = trim($1) AND device_type = 'pill' LIMIT 1\n)\nINSERT INTO batches (pill_device_id, temp_controller_device_id, start_date, beer_name, status)\nSELECT pd.device_id, pd.controller_id, $3, $2, 'active'\nFROM pill_device pd\nRETURNING\n  batch_id,\n  pill_device_id,\n  temp_controller_device_id,\n  (SELECT device_name FROM devices WHERE device_id = temp_controller_device_id) AS controller_name;",
