    {
      "parameters": {
        "jsCode": "const cmd = $('Parse Interaction Command').first().json;\nconst rows = $input.all();\n\nlet content;\nif (rows.length === 0 || rows[0].json.batch_id == null) {\n  content = '⚠️ ไม่พบ batch ที่ active อยู่สำหรับ Pill: ' + cmd.pill;\n} else {\n  const r = rows[0].json;\n  if (r.detected_phase == null) {\n    content = '📊 batch: ' + (r.beer_name || '(ไม่ระบุชื่อ)') + ' (Pill: ' + cmd.pill + ')\\nยังไม่มีข้อมูลวิเคราะห์เฟส (รอ Phase Analysis Cron รอบถัดไป)';\n  } else {\n    const checkedAt = DateTime.fromISO(r.checked_at).setZone('Asia/Bangkok').toFormat('d/M/yyyy HH:mm');\n    content = '📊 สถานะการหมัก: ' + (r.beer_name || '(ไม่ระบุชื่อ)') + ' (Pill: ' + cmd.pill + ')\\n'\n      + 'เฟสปัจจุบัน: ' + r.detected_phase + '\\n'\n      + 'gravity: ' + (r.gravity_sg ?? 'ไม่มีข้อมูล') + ' SG, อุณหภูมิ: ' + (r.temperature_c ?? 'ไม่มีข้อมูล') + '°C\\n'\n      + 'เช็คล่าสุดเมื่อ: ' + checkedAt + '\\n\\n'\n      + (r.ai_reasoning || '');\n  }\n}\n\nreturn [{\n  json: {\n    content,\n    application_id: cmd.application_id,\n    interaction_token: cmd.interaction_token\n  }\n}];"
      },
