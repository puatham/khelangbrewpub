    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  b.batch_id, b.beer_name,\n  pl.detected_phase, pl.ai_reasoning, pl.gravity_sg, pl.temperature_c, pl.gravity_velocity, pl.checked_at\nFROM batches b\nJOIN devices d ON d.device_id = b.pill_device_id\nLEFT JOIN LATERAL (\n  SELECT * FROM phase_log WHERE batch_id = b.batch_id ORDER BY checked_at DESC LIMIT 1\n) pl ON true\nWHERE trim(d.device_name) = trim($1) AND b.status = 'active'\nLIMIT 1;",
        "options": {
