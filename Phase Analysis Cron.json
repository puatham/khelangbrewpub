    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  b.batch_id, b.beer_name, b.current_phase, b.start_date,\n  dp.device_id AS pill_id, dp.device_name AS pill_name,\n  dc.device_id AS controller_id, dc.device_name AS controller_name\nFROM batches b\nJOIN devices dp ON dp.device_id = b.pill_device_id\nJOIN devices dc ON dc.device_id = b.temp_controller_device_id\nWHERE b.status = 'active';",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        440,
        0
      ],
      "id": "98863c11-aeac-47f4-910a-44090088f49d",
      "name": "Get Active Batches",
      "credentials": {
        "postgres": {
          "id": "t6ZZv3ZEHRRZX5Q2",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
