    {
      "parameters": {
        "url": "https://api.rapt.io/api/TemperatureControllers/GetTelemetry",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get RAPT Token').first().json.access_token }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "temperatureControllerId",
              "value": "={{ $json.controller_id }}"
            },
            {
              "name": "startDate",
              "value": "={{ $now.minus({hours:3}).toUTC().toISO() }}"
            },
            {
              "name": "endDate",
              "value": "={{ $now.toUTC().toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        680,
        -120
      ],
      "id": "43c92f8f-7420-4412-b5c6-f1572ad96f95",
      "name": "Get Controller Telemetry"
    },
    {
      "parameters": {
        "jsCode": "const inItems = $input.all();\n// รองรับทั้ง 2 แบบ: (a) 1 item ที่ json เป็น array ทั้งก้อน (b) แยกเป็นคนละ item ต่อ reading\nconst rows = [];\ninItems.forEach((it, idx) => {\n  const batch = $('Get Active Batches').itemMatching(idx).json;\n  const val = it.json;\n  const readings = Array.isArray(val) ? val : [val];\n  for (const t of readings) {\n    if (!t || !t.createdOn) continue;\n    rows.push({\n      json: {\n        device_id: batch.pill_id,\n        time_utc: t.createdOn,\n        temperature_c: t.temperature,\n        gravity_sg: t.gravity != null ? t.gravity / 1000 : null,\n        gravity_velocity_sg_per_day: t.gravityVelocity,\n        battery_percent: t.battery,\n        rssi_dbm: t.rssi,\n        paired_temp_controller: batch.controller_name\n      }\n    });\n  }\n});\nreturn rows;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -320
      ],
      "id": "ee79db4b-19d6-48ea-b9dc-26876d21e682",
      "name": "Format Pill Readings"
    },
    {
      "parameters": {
        "jsCode": "const inItems = $input.all();\nconst rows = [];\ninItems.forEach((it, idx) => {\n  const batch = $('Get Active Batches').itemMatching(idx).json;\n  const val = it.json;\n  const readings = Array.isArray(val) ? val : [val];\n  for (const t of readings) {\n    if (!t || !t.createdOn) continue;\n    rows.push({\n      json: {\n        device_id: batch.controller_id,\n        time_utc: t.createdOn,\n        temperature_c: t.temperature,\n        target_temperature_c: t.targetTemperature,\n        rssi_dbm: t.rssi\n      }\n    });\n  }\n});\nreturn rows;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -120
      ],
      "id": "00c0aa1c-ee58-466c-8e0b-0e01ba733caa",
      "name": "Format Controller Readings"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO pill_readings (device_id, time_utc, temperature_c, gravity_sg, gravity_velocity_sg_per_day, battery_percent, rssi_dbm, paired_temp_controller)\nVALUES ($1, $2, $3, $4, $5, $6, $7, $8)\nON CONFLICT (device_id, time_utc) DO NOTHING;",
        "options": {
          "queryReplacement": "={{$json.device_id}}, {{$json.time_utc}}, {{$json.temperature_c}}, {{$json.gravity_sg}}, {{$json.gravity_velocity_sg_per_day}}, {{$json.battery_percent}}, {{$json.rssi_dbm}}, {{$json.paired_temp_controller}}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1120,
        -320
      ],
      "id": "318ca684-98f9-4548-b855-d4eaab87a989",
      "name": "Insert Pill Readings",
      "credentials": {
        "postgres": {
          "id": "t6ZZv3ZEHRRZX5Q2",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO temp_controller_readings (device_id, time_utc, temperature_c, target_temperature_c, rssi_dbm)\nVALUES ($1, $2, $3, $4, $5)\nON CONFLICT (device_id, time_utc) DO NOTHING;",
        "options": {
          "queryReplacement": "={{$json.device_id}}, {{$json.time_utc}}, {{$json.temperature_c}}, {{$json.target_temperature_c}}, {{$json.rssi_dbm}}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1120,
        -120
      ],
      "id": "076c7236-7b5d-44f7-9b2a-698c4423788a",
      "name": "Insert Controller Readings",
      "credentials": {
        "postgres": {
          "id": "t6ZZv3ZEHRRZX5Q2",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  pr.gravity_sg, pr.gravity_velocity_sg_per_day, pr.temperature_c AS pill_temp_c, pr.time_utc AS pill_time_utc,\n  tr.temperature_c AS controller_temp_c, tr.target_temperature_c, tr.time_utc AS controller_time_utc\nFROM\n  (SELECT * FROM pill_readings WHERE device_id = $1 ORDER BY time_utc DESC LIMIT 1) pr\nFULL OUTER JOIN\n  (SELECT * FROM temp_controller_readings WHERE device_id = $2 ORDER BY time_utc DESC LIMIT 1) tr\nON true;",
        "options": {
          "queryReplacement": "={{$json.pill_id}}, {{$json.controller_id}}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        680,
        200
      ],
      "id": "5b7c6dc6-3f9f-4e86-b132-a6f59daeabc8",
      "name": "Get Latest Readings",
      "credentials": {
        "postgres": {
          "id": "t6ZZv3ZEHRRZX5Q2",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nitems.forEach((it, idx) => {\n  const batch = $('Get Active Batches').itemMatching(idx).json;\n  const r = it.json;\n\n  const startDate = new Date(batch.start_date);\n  const hoursSinceStart = (Date.now() - startDate.getTime()) / 3600000;\n\n  const promptText = `คุณคือผู้เชี่ยวชาญการหมักเบียร์ วิเคราะห์ว่าตอนนี้อยู่เฟสไหนใน 6 เฟสนี้:\n1. lag - 6-24 ชม.แรก ยีสต์ปรับตัว gravity แทบไม่ขยับ\n2. active_ferment - วันที่ 1-3 อัตราลด gravity สูงสุด (hi krausen)\n3. slowing - อัตราลดค่อยๆ ผ่อน\n4. fg_stable - gravity คงที่ต่อเนื่อง 1-2 วัน (ยีสต์กินเสร็จ)\n5. diacetyl_rest - ยกอุณหภูมิ +2 ถึง +4C ค้าง 2-3 วัน (บังคับทุก batch หลัง fg_stable)\n6. cold_crash - ลดอุณหภูมิใกล้ 0-4C 1-3 วัน\n\nข้อมูล batch \"${batch.beer_name || '(ไม่ระบุชื่อ)'}\":\n- เริ่มหมักมาแล้ว: ${hoursSinceStart.toFixed(1)} ชั่วโมง\n- เฟสล่าสุดที่บันทึกไว้: ${batch.current_phase}\n- gravity ปัจจุบัน: ${r.gravity_sg ?? 'ไม่มีข้อมูล'} SG\n- gravity velocity (ค่าดิบจาก RAPT ยังไม่แปลงหน่วย ดูแค่ทิศทาง/ขนาดสัมพัทธ์): ${r.gravity_velocity_sg_per_day ?? 'ไม่มีข้อมูล'}\n- อุณหภูมิ Pill: ${r.pill_temp_c ?? 'ไม่มีข้อมูล'}°C\n- อุณหภูมิตู้ (controller): ${r.controller_temp_c ?? 'ไม่มีข้อมูล'}°C\n- target temperature ตู้: ${r.target_temperature_c ?? 'ไม่มีข้อมูล'}°C\n\nตอบกลับเป็น JSON เท่านั้น ห้ามมีข้อความอื่นปนก่อน/หลัง รูปแบบ:\n{\"phase\": \"<lag|active_ferment|slowing|fg_stable|diacetyl_rest|cold_crash>\", \"reasoning\": \"<เหตุผลสั้นๆ ภาษาไทย>\"}`;\n\n  results.push({\n    json: {\n      batch_id: batch.batch_id,\n      beer_name: batch.beer_name,\n      current_phase: batch.current_phase,\n      gravity_sg: r.gravity_sg,\n      temperature_c: r.pill_temp_c,\n      gravity_velocity: r.gravity_velocity_sg_per_day,\n      prompt: promptText\n    }\n  });\n});\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "id": "3b9bbc17-70de-4777-9384-ad07647f0e78",
      "name": "Build AI Prompt"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-5"
            },
            {
              "name": "max_tokens",
              "value": "={{ 2048 }}"
            },
            {
              "name": "messages",
              "value": "={{ [{role: 'user', content: $json.prompt}] }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        200
      ],
      "id": "aa163879-943c-45d0-bc40-56c2fa4a1ff1",
      "name": "Call Claude",
      "credentials": {
        "anthropicApi": {
          "id": "7SpL8QSQuPFtKCz3",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nitems.forEach((it, idx) => {\n  const src = $('Build AI Prompt').itemMatching(idx).json;\n  let phase = null, reasoning = null;\n  try {\n    const textBlock = (it.json.content || []).find(c => c.type === 'text');\n    const text = textBlock ? textBlock.text : undefined;\n    const parsed = JSON.parse(text);\n    phase = parsed.phase;\n    reasoning = parsed.reasoning;\n  } catch (e) {\n    phase = src.current_phase; // parse ไม่ได้ -> คงเฟสเดิมไว้ก่อน ไม่เปลี่ยนมั่ว\n    reasoning = 'AI response parse error: ' + String(e);\n  }\n  results.push({\n    json: {\n      batch_id: src.batch_id,\n      beer_name: src.beer_name,\n      previous_phase: src.current_phase,\n      detected_phase: phase,\n      reasoning,\n      gravity_sg: src.gravity_sg,\n      temperature_c: src.temperature_c,\n      gravity_velocity: src.gravity_velocity\n    }\n  });\n});\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        200
      ],
      "id": "bf7d1c1a-5497-4daf-a39c-0a9a9b6ac0a6",
      "name": "Parse AI Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO phase_log (batch_id, gravity_sg, temperature_c, gravity_velocity, detected_phase, ai_reasoning)\nVALUES ($1, $2, $3, $4, $5, $6);",
        "options": {
          "queryReplacement": "={{$json.batch_id}}, {{$json.gravity_sg}}, {{$json.temperature_c}}, {{$json.gravity_velocity}}, {{$json.detected_phase}}, {{$json.reasoning}}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1560,
        200
      ],
      "id": "d74f55c0-290a-4889-8957-2d983fd01d9b",
      "name": "Insert Phase Log",
      "credentials": {
        "postgres": {
          "id": "t6ZZv3ZEHRRZX5Q2",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "8068c227-9955-4846-855a-d4b964908343",
              "leftValue": "={{ $('Parse AI Response').item.json.detected_phase }}",
              "rightValue": "={{ $('Parse AI Response').item.json.previous_phase }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1780,
        200
      ],
      "id": "0a533ae2-2967-4744-a6cc-25393c43d6ae",
      "name": "Phase Changed?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://discord.com/api/v10/channels/1537779906820177940/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "discordBotApi",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ '🔔 ' + $('Parse AI Response').item.json.beer_name + ': เฟสเปลี่ยนจาก ' + $('Parse AI Response').item.json.previous_phase + ' → ' + $('Parse AI Response').item.json.detected_phase + '\\n' + $('Parse AI Response').item.json.reasoning }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2000,
        120
      ],
      "id": "887cf0e9-5508-4014-a974-e6df9afd80c6",
      "name": "Send Discord Alert",
      "credentials": {
        "discordBotApi": {
          "id": "UoXr9Yvwl24SlcYu",
          "name": "Discord Bot account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE batches SET current_phase = $1, last_alert_at = now() WHERE batch_id = $2;",
        "options": {
          "queryReplacement": "={{ $('Parse AI Response').item.json.detected_phase }}, {{ $('Parse AI Response').item.json.batch_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
