        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "postgres",
          "uid": "rapt-pg"
        },
        "query": "SELECT CEIL(EXTRACT(EPOCH FROM (now() - start_date))/3600)::int::text || 'h' AS range FROM batches WHERE pill_device_id = '$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1",
