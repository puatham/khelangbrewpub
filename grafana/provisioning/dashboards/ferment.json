    {
      "id": 1,
      "title": "อุณหภูมิ — เบียร์ / ตู้ / target",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "rapt-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT p.time_utc AS time, p.temperature_c AS \"เบียร์ (Pill)\"\nFROM pill_readings p\nWHERE p.device_id = '$pill'::uuid AND p.time_utc >= (SELECT start_date FROM batches WHERE pill_device_id = '$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1)\nORDER BY 1",
          "datasource": {
            "type": "postgres",
            "uid": "rapt-pg"
          },
          "editorMode": "code"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT c.time_utc AS time,\n       c.temperature_c        AS \"ตู้ควบคุม\",\n       c.target_temperature_c AS \"target ที่ตั้งไว้\"\nFROM temp_controller_readings c\nWHERE c.device_id = (SELECT temp_controller_device_id FROM batches WHERE pill_device_id = '$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1) AND c.time_utc >= (SELECT start_date FROM batches WHERE pill_device_id = '$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1)\nORDER BY 1",
          "datasource": {
            "type": "postgres",
            "uid": "rapt-pg"
          },
          "editorMode": "code"
        },
        {
          "refId": "C",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t AS time, lo AS \"ขอบล่างที่ตั้งไว้\", hi AS \"ขอบบนที่ตั้งไว้\" FROM (\n  SELECT (SELECT start_date FROM batches WHERE pill_device_id = '$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1) AS t,\n         (SELECT beer_band_low_c FROM batches WHERE pill_device_id='$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1) AS lo,\n         (SELECT beer_band_high_c FROM batches WHERE pill_device_id='$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1) AS hi\n  UNION ALL\n  SELECT now(),\n         (SELECT beer_band_low_c FROM batches WHERE pill_device_id='$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1),\n         (SELECT beer_band_high_c FROM batches WHERE pill_device_id='$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1)\n) x WHERE lo IS NOT NULL ORDER BY 1",
          "datasource": {
            "type": "postgres",
            "uid": "rapt-pg"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 4
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*ขอบ.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    8
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target ที่ตั้งไว้"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    4,
                    4
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "timeFrom": "$range"
    },
