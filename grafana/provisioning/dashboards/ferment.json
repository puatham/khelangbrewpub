          "rawQuery": true,
          "rawSql": "SELECT EXTRACT(EPOCH FROM (now() - MIN(checked_at)))/3600 AS \"ชม.\"\nFROM phase_log WHERE batch_id = (SELECT batch_id FROM batches WHERE pill_device_id = '$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1)\n  AND checked_at > COALESCE((SELECT MAX(checked_at) FROM phase_log\n        WHERE batch_id = (SELECT batch_id FROM batches WHERE pill_device_id = '$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1) AND detected_phase IS DISTINCT FROM (SELECT detected_phase FROM phase_log WHERE batch_id = (SELECT batch_id FROM batches WHERE pill_device_id = '$pill'::uuid ORDER BY (status = 'active') DESC, start_date DESC, batch_id DESC LIMIT 1) ORDER BY checked_at DESC LIMIT 1)),\n        '-infinity'::timestamptz)",
          "datasource": {
