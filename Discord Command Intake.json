        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "discordApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "after",
              "value": "={{ $json.value }}"
            },
            {
              "name": "limit",
              "value": "50"
            }
